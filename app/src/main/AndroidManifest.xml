<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:name=".ClipCutApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:usesCleartextTraffic="true"
        android:theme="@style/Theme.ClipCut">

        <!-- X Auto: the launcher. One card per feature; each feature is its own Activity. -->
        <activity
            android:name=".ui.home.HomeActivity"
            android:exported="true"
            android:theme="@style/Theme.ClipCut">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Clip Cut: OBS via MediaMTX HLS: live view, scrub, preview, export to gallery. -->
        <activity
            android:name=".lan.LanBufferActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:theme="@style/Theme.ClipCut" />

        <!-- Caption Generator: the caption screen on its own; copies just the caption. -->
        <activity
            android:name=".ui.caption.CaptionGeneratorActivity"
            android:exported="false"
            android:theme="@style/Theme.ClipCut" />

        <!-- Trigger Deletion: find, review, confirm, then paced deletion of the media account's posts. -->
        <activity
            android:name=".ui.deletion.DeletionActivity"
            android:exported="false"
            android:theme="@style/Theme.ClipCut" />

        <!-- GC Prune: scan a group chat, review, then remove members who don't follow the main account. -->
        <activity
            android:name=".ui.gcprune.GcPruneActivity"
            android:exported="false"
            android:theme="@style/Theme.ClipCut" />

        <!-- Unfollowers: reads the tracker and lists who unfollowed the main account. -->
        <activity
            android:name=".ui.unfollows.UnfollowsActivity"
            android:exported="false"
            android:theme="@style/Theme.ClipCut" />

        <!-- Caption and post-to-X flow, launched from LanBufferActivity after a successful export.
             Separate Activity so nothing in it can affect the export and marking flow. -->
        <activity
            android:name=".lan.CaptionPostActivity"
            android:exported="false"
            android:theme="@style/Theme.ClipCut" />

    </application>

</manifest>
