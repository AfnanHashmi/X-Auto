<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:name=".ClipCutApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.ClipCut">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.ClipCut">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Phase 1 spike (throwaway, see plan doc). Exported only so adb shell am start can launch
             it directly for testing; not linked from anywhere else in the app. -->
        <activity
            android:name=".spike.SpikeUdpActivity"
            android:exported="true"
            android:theme="@style/Theme.ClipCut" />

        <!-- LAN low-latency buffer control (Start Buffer / Kill). Standalone, not yet linked from
             the main nav graph; launch via adb for now, exported only for that. -->
        <activity
            android:name=".lan.LanBufferActivity"
            android:exported="true"
            android:theme="@style/Theme.ClipCut" />
    </application>

</manifest>
