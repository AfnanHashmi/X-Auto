<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name=".ClipCutApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.ClipCut">

        <!-- The app's only screen: OBS/UDP low-latency buffer control, scrub, preview, export to
             gallery. The LLHLS online-URL path (and the caption/post-to-X pipeline that hung off
             it) has been removed entirely; this is the app now, not a side mode. -->
        <activity
            android:name=".lan.LanBufferActivity"
            android:exported="true"
            android:theme="@style/Theme.ClipCut">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Caption and post-to-X flow, launched from LanBufferActivity after a successful export.
             Separate Activity so nothing in it can affect the export and marking flow. -->
        <activity
            android:name=".lan.CaptionPostActivity"
            android:exported="false"
            android:theme="@style/Theme.ClipCut" />

        <!-- Keeps the UDP receive + rolling-chunk recording alive while the app is backgrounded,
             behind a persistent "running in background" notification; see its own doc comment. -->
        <service
            android:name=".lan.LanBufferForegroundService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />
    </application>

</manifest>
